# ---- AION backend configuration -------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# Generate AION_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

AION_ENVIRONMENT=dev
AION_DEBUG=false
AION_SECRET_KEY=

# comma separated, must be explicit (no wildcard in production)
AION_CORS_ORIGINS=http://localhost:8080

# storage
AION_DATABASE_URL=postgresql+asyncpg://aion:aion_dev_pw@127.0.0.1:5432/aion
AION_REDIS_URL=redis://127.0.0.1:6379/0

# trading safety: PAPER | TESTNET | MAINNET
# MAINNET stays disabled until AION_MAINNET_ENABLED=true AND the user unlocks it
# in the app after every mainnet gate in the acceptance checklist passes.
AION_TRADING_MODE=PAPER
AION_MAINNET_ENABLED=false
# JSON 数组，必须带引号，否则 dotenv 会去掉双引号导致解析失败
AION_DEFAULT_SYMBOLS='["BTCUSDT","ETHUSDT","SOLUSDT"]'

# Binance USDⓈ-M Futures (server side only, never in the APK)
AION_BINANCE_TESTNET_API_KEY=
AION_BINANCE_TESTNET_API_SECRET=
AION_BINANCE_MAINNET_API_KEY=
AION_BINANCE_MAINNET_API_SECRET=

# model gateway (server side only)
AION_ANTHROPIC_API_KEY=
AION_ANTHROPIC_BASE_URL=https://api.anthropic.com
AION_OPENAI_API_KEY=
AION_OPENAI_BASE_URL=https://api.openai.com/v1
AION_MODEL_DAILY_BUDGET_USD=5
AION_MODEL_RUN_BUDGET_USD=0.75
AION_AGENT_RUN_TIMEOUT_SECONDS=180
AION_AGENT_MAX_CONCURRENCY=3

# market data freshness
AION_MARKET_STALE_SECONDS=90

# AION v2.12 Autonomous Research Lab
AION_RESEARCH_WORKER_ENABLED=true
AION_RESEARCH_AUTOSCHEDULE_ENABLED=true
# Daily auto research uses the first configured default symbol per eligible user.
