# AION PAPER-only runtime profile
# Copy to backend/.env for a simulation deployment. Never add exchange credentials.
AION_ENVIRONMENT=dev
AION_DEBUG=false
AION_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
AION_CORS_ORIGINS=http://localhost:8080

AION_DATABASE_URL=postgresql+asyncpg://aion:aion_dev_pw@127.0.0.1:5432/aion
AION_REDIS_URL=redis://127.0.0.1:6379/0

# Simulation-only: no exchange execution credentials.
AION_TRADING_MODE=PAPER
AION_MAINNET_ENABLED=false
AION_DEFAULT_SYMBOLS='["BTCUSDT","ETHUSDT","SOLUSDT"]'
AION_BINANCE_TESTNET_API_KEY=
AION_BINANCE_TESTNET_API_SECRET=
AION_BINANCE_MAINNET_API_KEY=
AION_BINANCE_MAINNET_API_SECRET=

# AI provider keys are server-side only; configure through your secret manager.
AION_ANTHROPIC_API_KEY=
AION_OPENAI_API_KEY=
AION_MODEL_DAILY_BUDGET_USD=5
AION_MODEL_RUN_BUDGET_USD=0.75
AION_AGENT_RUN_TIMEOUT_SECONDS=180
AION_AGENT_MAX_CONCURRENCY=3

# Continuous PAPER research + autopilot.
AION_RESEARCH_WORKER_ENABLED=true
AION_AUTOPILOT_ENABLED=true
AION_AUTOPILOT_TICK_SECONDS=10
AION_INGEST_ENABLED=true
AION_INGEST_INTERVAL_SECONDS=60

# Keep exchange account sync and user-data streams off in PAPER-only profile.
AION_ACCOUNT_SYNC_ENABLED=false
AION_USER_STREAM_ENABLED=false
AION_LIVE_STREAM_ENABLED=false
