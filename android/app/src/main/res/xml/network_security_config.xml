<?xml version="1.0" encoding="utf-8"?>
<!--
  BUG-25 fix: cleartext HTTP is denied by default for every build.
  Local development endpoints (emulator host 10.0.2.2, loopback, and
  private LAN ranges used for on-device testing) are explicitly allowed
  via domain-config entries below.

  Notes:
  - domain entries match IP literals as well as hostnames.
  - Wildcards like 192.168.*.* are NOT supported by the platform; add the
    concrete dev machine IP as an extra <domain> entry if you test against
    a physical device on Wi-Fi (e.g. <domain>192.168.1.20</domain>).
  - These exceptions only matter if the configured API base URL is plain
    http:// — the default base URL is now https:// (see BUG-26 fix).
-->
<network-security-config>

    <!-- Default for all traffic, all build types: HTTPS only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local development exceptions: emulator host + loopback. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- LAN dev server: add your machine's concrete IP here when testing on a
         physical device (wildcards are not supported for IP literals). -->

</network-security-config>
